# Copia este archivo como .env.local y ajusta los valores. Nunca subas .env.local al repositorio.

# ── Base de datos MySQL ──────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=miscuentas
DB_PASSWORD=cambia-esta-clave
DB_NAME=miscuentas
# Conexiones simultáneas del pool. Clever Cloud (plan gratuito) permite 5 por usuario y las
# comparten producción, tu equipo local y PhpMyAdmin: usa 2 o 3 en cada instancia.
DB_POOL_SIZE=3
# Cierra las conexiones inactivas tras estos milisegundos (libera cupos para otros clientes).
DB_IDLE_TIMEOUT_MS=15000

# ── Administrador inicial (lo crea `npm run seed` si no existe) ──────
# La contraseña debe tener 8+ caracteres con letras y números.
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=CambiaEsto2026

# ── Aplicación ───────────────────────────────────────────────────────
# URL pública (se usa en los enlaces de los correos). Obligatoria en producción.
APP_URL=http://localhost:3000
# Secreto de 32+ caracteres para cifrar los secretos de 2FA y firmar retos.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=cambia-esto-por-un-secreto-aleatorio-de-32-caracteres
# Protege /api/cron/reminders (recordatorios diarios). Mínimo 16 caracteres.
CRON_SECRET=cambia-esto-tambien-123456
# Zona horaria de negocio: define cuándo empieza cada mes.
APP_TIMEZONE=America/Bogota
# Pon "true" solo si la app corre detrás de un proxy confiable (Vercel, Nginx…)
# para leer la IP real desde X-Forwarded-For en el limitador de intentos.
TRUST_PROXY=false
# ID de Google Tag Manager / Analytics (déjalo vacío para desactivarlo)
NEXT_PUBLIC_GTM_ID=G-NLFHM81592

# ── Correo (recuperar contraseña, verificar correo, recordatorios) ──
# Sin SMTP_HOST, en desarrollo los correos se imprimen en la consola del servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MizCuentas <no-reply@tu-dominio.com>
